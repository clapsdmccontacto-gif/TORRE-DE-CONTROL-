# API (backend/)
PORT=3000

# Base de datos de docker-compose.yml (npm run db:up). Con DATABASE_URL el backend guarda
# ahí los datos de la empresa (camiones, bodega, productos, obras, pedidos); sin ella, en
# memoria. Exportarla antes de npm run dev:api.
DATABASE_URL=postgres://torre:torre_dev@localhost:5432/torre_control
